# Rendered by dotfiles/install-tier-c.ps1 to %USERPROFILE%\.gitconfig
# Placeholders (installer substitutes at copy time):
#   __GIT_USER_NAME__   -- prompted if $env:GIT_USER_NAME is not set
#   __GIT_USER_EMAIL__  -- prompted if $env:GIT_USER_EMAIL is not set
#
# NOT included on purpose:
#   [safe]  directory = ...   -- these auto-accumulate as `git config
#                                  --add safe.directory <path>` when git
#                                  prompts you inside a shared checkout.
#                                  Per-machine; do not template.
#
# NOT included on purpose (secrets belong nowhere near this file):
#   OAuth tokens, PATs, SSH keys.

[user]
	name = __GIT_USER_NAME__
	email = __GIT_USER_EMAIL__
[credential]
	helper = manager
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[http]
	sslVerify = true
